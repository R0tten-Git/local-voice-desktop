{
  "name": "local-voice-desktop",
  "version": "0.10.1",
  "private": false,
  "description": "Local, offline real-time speech-to-text for macOS and Windows — Qwen3-ASR, no cloud, no account.",
  "type": "commonjs",
  "main": "src/main.js",
  "license": "MIT",
  "keywords": [
    "speech-to-text",
    "asr",
    "qwen3",
    "mlx",
    "offline",
    "desktop",
    "electron"
  ],
  "scripts": {
    "dev": "electron .",
    "probe": "node scripts/probe.js",
    "build:mac": "electron-builder --mac --arm64 --publish never",
    "build:win": "electron-builder --win --x64 --publish never",
    "prebuild:mac": "node scripts/fetch-uv.mjs && node scripts/fetch-llama.mjs",
    "prebuild:win": "node scripts/fetch-uv.mjs && node scripts/fetch-llama.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.localvoice.desktop",
    "productName": "LocalVoice",
    "files": [
      "src/**/*",
      "engine/**/*",
      "scripts/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      },
      {
        "from": "vendor/uv",
        "to": "uv"
      },
      {
        "from": "vendor/llama",
        "to": "llama"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "artifactName": "LocalVoice-${version}-arm64.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "LocalVoice 需要麦克风来把你说的话转成文字。音频只在本机处理。"
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "LocalVoice-${version}-x64-setup.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "author": "R0tten-Git"
}
